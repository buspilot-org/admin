# Local Supabase from buspilot-org/server (`npx supabase start` there).
# These are the public values of the local stack; `npx supabase status`
# prints them. Never put a secret key here: the admin console only needs the
# publishable key, row-level security does the rest.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Optional: MapLibre style URL (default: OpenFreeMap "liberty", free, no key).
# NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional: link encoded in invite QR codes; {code} is replaced.
# NUXT_PUBLIC_RIDER_JOIN_URL=https://app.buspilot.org/join#code={code}
